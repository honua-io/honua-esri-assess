{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@honua/sdk-js": ["../../src/index.ts"],
      "@honua/sdk-js/migration": ["../../src/migration-entry.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
